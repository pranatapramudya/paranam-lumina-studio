generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  KASIR
  OWNER
}

enum PaymentMethod {
  PACKAGE_CREDIT
  TRANSFER_MANUAL
  CASH_STUDIO
  QRIS_MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum AttendanceStatus {
  PENDING
  ATTENDED
  ABSENT
  CANCELLED
}

model User {
  id                String        @id @default(cuid())
  name              String
  phone             String        @unique
  pin               String        @default("123456")
  role              Role          @default(MEMBER)
  remainingCredits  Int           @default(0)
  activePackageName String?
  packageExpiry     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings          Booking[]
  transactions      Transaction[]
}

model ClassSchedule {
  id              String    @id @default(cuid())
  title           String
  category        String
  instructor      String
  instructorPhoto String?
  description     String?
  date            DateTime
  startTime       String
  endTime         String
  durationMinutes Int       @default(75)
  price           Float     @default(90000)
  maxCapacity     Int       @default(10)
  room            String    @default("Studio Utama Paranam")
  status          String    @default("UPCOMING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]
}

model Booking {
  id               String           @id @default(cuid())
  bookingCode      String           @unique
  userId           String
  scheduleId       String
  paymentMethod    PaymentMethod    @default(PACKAGE_CREDIT)
  paymentStatus    PaymentStatus    @default(PAID)
  attendanceStatus AttendanceStatus @default(PENDING)
  amount           Float
  proofImageUrl    String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  schedule         ClassSchedule    @relation(fields: [scheduleId], references: [id])
}

model Package {
  id            String        @id @default(cuid())
  name          String
  description   String?
  category      String        @default("ALL_ACCESS")
  price         Float
  originalPrice Float?
  totalSessions Int           @default(5)
  validityDays  Int           @default(30)
  imageUrl      String?
  isPopular     Boolean       @default(false)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  userId        String
  packageId     String?
  type          String
  amount        Float
  paymentMethod PaymentMethod @default(TRANSFER_MANUAL)
  status        PaymentStatus @default(PENDING)
  proofImageUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  package       Package?      @relation(fields: [packageId], references: [id])
}

model StudioSetting {
  id               String   @id @default("paranam-config")
  studioName       String   @default("Paranam Lumina Studio")
  tagline          String   @default("A home to wellness - Boutique Yoga & Pilates")
  address          String   @default("Depok, Jawa Barat")
  whatsappNumber   String   @default("6281234567890")
  bcaAccountNumber String   @default("7140982311")
  bcaAccountName   String   @default("Paranam Lumina Studio")
  defaultCapacity  Int      @default(10)
  updatedAt        DateTime @updatedAt
}
